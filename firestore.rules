rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isCoach() {
      return isSignedIn() && request.auth.token.role == 'coach';
    }

    function isStudent() {
      return isSignedIn() && request.auth.token.role == 'student';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (isCoach() && resource.data.coachId == request.auth.uid)
      );
      allow write: if false;
    }

    match /muscleGroups/{groupId} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }

    match /exerciseLibrary/{groupId}/exercises/{exerciseId} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }

    match /workouts/{workoutId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.coachId == request.auth.uid
      );

      allow create: if isCoach() && request.resource.data.coachId == request.auth.uid;

      allow update: if isCoach() && resource.data.coachId == request.auth.uid;

      // A student may only complete their own pending workout, and may only
      // touch these four fields (they can't reassign it or change its groups).
      allow update: if isStudent()
        && resource.data.studentId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'completed'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'checkInTime', 'videoLink', 'completedAt']);

      allow delete: if isCoach() && resource.data.coachId == request.auth.uid;

      match /entries/{entryId} {
        allow read: if isSignedIn() && (
          resource.data.studentId == request.auth.uid ||
          resource.data.coachId == request.auth.uid
        );

        // Students can add entries only to their own pending workout, and the
        // coachId must match the parent. There is no update or delete rule on
        // purpose: once submitted, entries can't be changed.
        allow create: if isStudent()
          && request.resource.data.studentId == request.auth.uid
          && get(/databases/$(database)/documents/workouts/$(workoutId)).data.studentId == request.auth.uid
          && get(/databases/$(database)/documents/workouts/$(workoutId)).data.status == 'pending'
          && request.resource.data.coachId ==
               get(/databases/$(database)/documents/workouts/$(workoutId)).data.coachId;
      }
    }
  }
}